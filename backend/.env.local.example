# Local development environment
# Copy this file and fill in LOCAL Gmail OAuth credentials:
#   cp .env.local.example .env.local
#
# Production uses load_env.sh on the server — do NOT copy production
# GMAIL_* values here. Create a separate Google OAuth client for localhost
# (Authorized redirect URI: http://localhost:8080/), then run:
#   python setup_gmail_oauth.py
# and paste the resulting token into GMAIL_TOKEN_JSON below
# (or use GMAIL_TOKEN_FILE pointing at backend/gmail_token.json).

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
DJANGO_ENV=local
DJANGO_SECRET_KEY=django-insecure-local-dev-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database (local MySQL)
# -----------------------------------------------------------------------------
DB_NAME=Booking_calendar
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306

# -----------------------------------------------------------------------------
# CORS / locale
# -----------------------------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=True
LANGUAGE_CODE=fr-fr
TIME_ZONE=Europe/Paris

# -----------------------------------------------------------------------------
# Email (same addresses as prod — only OAuth credentials differ)
# -----------------------------------------------------------------------------
DEFAULT_FROM_EMAIL=backendsmtp7@gmail.com
CONTACT_EMAIL_RECIPIENTS=backendsmtp7@gmail.com

# -----------------------------------------------------------------------------
# Gmail OAuth2 — LOCAL ONLY (different from production)
# Get these from a dedicated Google Cloud OAuth client for local testing.
# -----------------------------------------------------------------------------
GMAIL_CLIENT_ID=your-local-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-local-client-secret

# After running setup_gmail_oauth.py, either:
# A) Point to the token file (easiest for local):
GMAIL_TOKEN_FILE=backend/gmail_token.json

# B) Or paste the full JSON on one line (use single quotes around the JSON):
# GMAIL_TOKEN_JSON='{"token":"...","refresh_token":"...","token_uri":"https://oauth2.googleapis.com/token","client_id":"...","client_secret":"...","scopes":["https://www.googleapis.com/auth/gmail.send"]}'

# Optional: path to the downloaded client_secret JSON from Google Cloud Console
# GMAIL_CREDENTIALS_FILE=path/to/local_client_secret.json
