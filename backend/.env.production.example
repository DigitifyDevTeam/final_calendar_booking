# Production environment template
# Copy to .env.production and fill with server values (from load_env.sh on the host):
#   cp .env.production.example .env.production
#
# On the Linux server you can keep using load_env.sh + start_production.sh instead.
# This file is for: DJANGO_ENV=production on a machine that uses dotenv.

DJANGO_ENV=production
DJANGO_SECRET_KEY=change-me-production-secret
DJANGO_ALLOWED_HOSTS=dev.woodagency.fr,www.dev.woodagency.fr
DJANGO_LOG_LEVEL=INFO

DB_NAME=your_prod_db
DB_USER=your_prod_user
DB_PASSWORD=your_prod_password
DB_HOST=localhost
DB_PORT=3306

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://dev.woodagency.fr,https://www.dev.woodagency.fr

LANGUAGE_CODE=fr-fr
TIME_ZONE=Europe/Paris

DEFAULT_FROM_EMAIL=contact@woodagency.fr
CONTACT_EMAIL_RECIPIENTS=contact@woodagency.fr

# Production Gmail OAuth (from load_env.sh — different from .env.local)
GMAIL_CLIENT_ID=your-prod-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-prod-client-secret
GMAIL_TOKEN_JSON='{"token":"...","refresh_token":"...","token_uri":"https://oauth2.googleapis.com/token","client_id":"...","client_secret":"...","scopes":["https://www.googleapis.com/auth/gmail.send"]}'
