{
  // Terminal Settings
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  
  // Terminal Appearance
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontFamily": "Consolas, 'Courier New', monospace",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  
  // Terminal Colors & Theme
  "terminal.integrated.background": "#1e1e1e",
  "terminal.integrated.foreground": "#cccccc",
  
  // Terminal Behavior
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.confirmOnExit": "never",
  "terminal.integrated.enableMultiLinePasteWarning": false,
  
  // Terminal Profiles (PowerShell, CMD, Git Bash, etc.)
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell",
      "args": ["-NoLogo"]
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\System32\\cmd.exe"
      ],
      "args": [],
      "icon": "terminal-cmd"
    },
    "Git Bash": {
      "source": "Git Bash",
      "icon": "terminal-bash"
    }
  },
  
  // Terminal Shell Integration
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.shellIntegration.history": 1000,
  
  // Terminal Copy/Paste
  "terminal.integrated.copyOnSelection": false,
  "terminal.integrated.rightClickBehavior": "default",
  
  // Editor Cursor Settings
  "editor.cursorColor": "#284B73",
  "editor.cursorStyle": "line",
  "editor.cursorWidth": 2,
  "editor.cursorBlinking": "smooth",
  
  // Diff Editor Colors (for showing changes)
  "diffEditor.insertedTextBackground": "#10b98120",
  "diffEditor.insertedTextBorder": "#10b98140",
  "diffEditor.removedTextBackground": "#284B7330",
  "diffEditor.removedTextBorder": "#284B73",
  "diffEditor.removedTextForeground": "#284B73",
  "diffEditor.modifiedTextBackground": "#284B7320",
  "diffEditor.modifiedTextBorder": "#284B7340",
  
  // Git Colors (for change indicators)
  "git.decorations.addedResourceForeground": "#10b981",
  "git.decorations.modifiedResourceForeground": "#284B73",
  "git.decorations.deletedResourceForeground": "#284B73",
  
  // Editor Selection Colors
  "editor.selectionBackground": "#284B7340",
  "editor.selectionHighlightBackground": "#284B7320",
  "editor.wordHighlightBackground": "#284B7315",
  "editor.wordHighlightStrongBackground": "#284B7325",
  
  // Workbench Colors for Diff (more reliable)
  "workbench.colorCustomizations": {
    "diffEditor.removedTextBackground": "#284B7330",
    "diffEditor.removedTextBorder": "#284B73",
    "diffEditor.removed": "#284B73",
    "diffEditor.removedLineBackground": "#284B7320"
  }
}

